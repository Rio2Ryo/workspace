# Discord Developer Portalで作成したBot Token
DISCORD_TOKEN=replace_me

# backend: ollama または openai
# - ollama: ローカルOllama HTTP API /api/chat  ← Mac mini デフォルト
# - openai: llama-server, vLLM, LiteLLM などのOpenAI互換API（Vast.ai GPU使用時）
LLM_BACKEND=ollama

# OpenAI互換API設定（Gemma4 GGUFをllama-serverで動かす場合はこちら）
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=sk-local
LLM_MODEL=gemma4-26b-a4b
ENABLE_THINKING=false
TEMPERATURE=1.0
TOP_P=0.95
MAX_TOKENS=2048

# Ollama設定（LLM_BACKEND=ollama の場合）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=lukey03/qwen3.5-9b-abliterated:latest

# Discord上でメンション以外にも使うprefix
BOT_PREFIX=!agent

# チャンネルごとに保持する会話履歴数
MAX_HISTORY_MESSAGES=12
MAX_USER_CHARS=6000

# Botの基本人格
SYSTEM_PROMPT=You are a helpful local uncensored AI assistant. Reply in Japanese by default. Be concise, practical, and honest.

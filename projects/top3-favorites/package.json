{
  "name": "top3-favorites-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:local": "node scripts/preview-local.mjs",
    "test:e2e": "playwright test",
    "test:e2e:clean": "node scripts/run-playwright-clean.mjs",
    "test:e2e-clean-script": "node --test tests/run-playwright-clean.test.mjs",
    "test:qa-docs": "node --test tests/qa-coverage-doc.test.mjs",
    "test:copy-docs": "node --test tests/concept-copy-contract.test.mjs",
    "test:qa-current": "node --test tests/qa-current-contract.test.mjs",
    "test:legacy-zero-run-script": "node --test tests/derive-legacy-zero-run-count.test.mjs",
    "test:legacy-zero-run-env-script": "node --test tests/derive-legacy-zero-run-env.test.mjs",
    "test:qa-failure-summary-script": "node --test tests/summarize-qa-failure.test.mjs",
    "test:tag-normalization-contract": "node --test tests/tag-normalization-contract.test.mjs",
    "test:import-preview-summary-contract": "node --test tests/import-preview-summary-contract.test.mjs",
    "test:export-download-helper-contract": "node --test tests/export-download-helper-contract.test.mjs",
    "test:import-file-helper-contract": "node --test tests/import-file-helper-contract.test.mjs",
    "test:quick": "pnpm test:qa-current && pnpm test:qa-docs",
    "test:docs-only": "pnpm test:qa-current && pnpm test:qa-docs && pnpm test:copy-docs",
    "test:import-preview-only": "playwright test tests/import-preview",
    "test:import-preview-direction": "playwright test tests/import-preview/direction",
    "test:import-preview-live": "playwright test tests/import-preview/live",
    "test:import-preview-tags": "playwright test tests/import-preview/tags",
    "test:import-preview-terms": "playwright test tests/import-preview/terms",
    "test:import-preview-naming": "playwright test tests/import-preview/naming",
    "test:import-preview-summary": "playwright test tests/import-preview/summary",
    "test:full": "pnpm test:docs-only && pnpm test:legacy-zero-run-script && pnpm test:legacy-zero-run-env-script && pnpm test:qa-failure-summary-script && pnpm test:tag-normalization-contract && pnpm test:import-preview-summary-contract && pnpm test:export-download-helper-contract && pnpm test:import-file-helper-contract && pnpm test:e2e-clean-script && pnpm test:e2e:clean && pnpm build"
  },
  "dependencies": {
    "@vercel/blob": "^2.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}

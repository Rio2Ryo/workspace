<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd entry for sync.py — Threads-watcher snapshot sync.
  ACTIVATED IN DRY-RUN MODE (no --confirm, no --enable-push).

  Why this is safe to activate without explicit approval:
    - Default behaviour writes ONLY to logs/sync.{out,err}.log.
    - No git commits, no pushes, no DB writes.
    - sync.py's own guard layer (--confirm gates commits, --enable-push
      gates pushes) is the source of truth — this plist just runs the
      script periodically with no write flags.

  Operator promotion to real syncing (after dry-run logs look healthy):
    Edit the ProgramArguments array below to uncomment --confirm
    (commits enabled) and optionally --enable-push (pushes enabled).
    Then `launchctl unload -w && launchctl load -w`.

  Install location:
    ~/Library/LaunchAgents/com.shiro.threads-watcher-sync.plist

  Activate:
    launchctl load -w ~/Library/LaunchAgents/com.shiro.threads-watcher-sync.plist

  Disable (rollback):
    launchctl unload -w ~/Library/LaunchAgents/com.shiro.threads-watcher-sync.plist

  Status:
    launchctl list | grep threads-watcher-sync
    tail -f logs/sync.out.log

  Defaults:
    - 30-minute StartInterval
    - RunAtLoad=false (no immediate fire at install)
    - logs to logs/sync.{out,err}.log (no rotation)

  Supersedes com.shiro.threads-watcher-sync.plist.example. The .example
  is kept for reference; this file is the live, agent-activatable
  version (DRY-RUN only).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.shiro.threads-watcher-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/umi/.openclaw/workspace/projects/threads-watcher/sync.py</string>
    <!-- DRY-RUN. Uncomment these to promote to live commits / pushes:   -->
    <!-- <string>--confirm</string>     -->
    <!-- <string>--enable-push</string> -->

    <!-- Log rotation: cap sync.log at 1 MB with 5 backups = 5 MB
         ceiling. At observed ~5 KB/day cadence this rotates roughly
         twice a year; safety net for a future loglevel bump. Code
         shipped in 9a0f888; this activates it. -->
    <string>--max-log-bytes</string>
    <string>1048576</string>
    <string>--log-backup-count</string>
    <string>5</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <false/>

  <!-- StandardOutPath DELIBERATELY OMITTED.
       sync.py writes nothing to stdout — all logging flows through
       TeeLogger (sync.py:177-188) which writes to BOTH sys.stderr
       (captured below into sync.err.log) AND the file at
       --log (default logs/sync.log). The previous
       StandardOutPath kept logs/sync.out.log at 0 bytes for the
       whole install lifetime — pure noise. When the key is absent
       launchd inherits /dev/null which is exactly what we want.
       Regression-guarded by tests/test_plist_log_routing.py so a
       future agent re-adding it surfaces immediately.

       sibling: com.shiro.threads-watcher-auto-restart.plist DOES
       set StandardOutPath because auto-restart-if-stale.sh's
       ts_log() writes via printf to stdout (auto-restart.out.log
       is ~11KB on a running install). Don't generalise this
       deletion. -->
  <key>StandardErrorPath</key>
  <string>/Users/umi/.openclaw/workspace/projects/threads-watcher/logs/sync.err.log</string>

  <key>WorkingDirectory</key>
  <string>/Users/umi/.openclaw/workspace/projects/threads-watcher</string>
</dict>
</plist>

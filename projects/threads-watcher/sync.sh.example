#!/usr/bin/env bash
# threads-watcher 自動同期スクリプト
#
# **SUPERSEDED BY sync.py** (2026-05-18).
# このシェル版はリファレンス用に残しています。新規導入・launchd 切替時は
# 同じディレクトリの sync.py を使ってください(同じガード・同じデフォルト・
# テスト 49 件カバー、end-to-end 検証済)。
#   python3 sync.py                          # dry-run (default)
#   python3 sync.py --confirm                # commit only
#   python3 sync.py --confirm --enable-push  # commit + push
#
# 目的: SQLite DB の posts 増分を検出した時だけ、threads-watcher-status/state.json
#       の git commit を行う(push は別判断)。
#
# 安全ガード:
#   - DB 増分ゼロなら早期 exit(commit/push しない)
#   - 直近 N(=3) 回の checks.status に 'error' が混じっていたら skip(障害ガード)
#   - 直近 commit が COMMIT_MIN_GAP_SEC(=3600)以内なら skip(頻度上限)
#   - push は ENABLE_PUSH=1 を環境変数で明示しない限り行わない(デフォルト OFF)
#
# 使用方法(承認後):
#   1. このファイルを sync.sh にリネーム(`.example` を外す)
#   2. chmod +x sync.sh
#   3. launchd 経由で 15-30 分間隔起動(plist は com.shiro.threads-watcher-sync.plist.example 参照)
#
# 注意:
#   - run-watcher.sh は別プロセスで常駐済(60 秒ループで DB 書込)
#   - 本スクリプトは別レイヤ(snapshot を git に反映するだけ)

set -euo pipefail

# ── 設定 ──────────────────────────────────────────────
PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
DB_FILE="${PROJECT_DIR}/threads_watcher.db"
SNAPSHOT_FILE="${PROJECT_DIR}/threads-watcher-status/state.json"
CURSOR_FILE="${PROJECT_DIR}/.sync_cursor"
LOG_FILE="${PROJECT_DIR}/logs/sync.log"
WORKSPACE_DIR="${PROJECT_DIR%/projects/*}"
COMMIT_MIN_GAP_SEC="${COMMIT_MIN_GAP_SEC:-3600}"
ENABLE_PUSH="${ENABLE_PUSH:-0}"
DRY_RUN="${DRY_RUN:-0}"     # 1 = ガード判定までは走るが git/cursor は触らない
GIT_BRANCH="${GIT_BRANCH:-shiro/phase2-perf-metrics}"

log() { mkdir -p "$(dirname "$LOG_FILE")"; printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$LOG_FILE" >&2; }

# ── 前提チェック ──────────────────────────────────────
[ -f "$DB_FILE" ] || { log "ERROR: DB not found: $DB_FILE"; exit 1; }
[ -f "$SNAPSHOT_FILE" ] || { log "ERROR: snapshot not found: $SNAPSHOT_FILE"; exit 1; }
command -v sqlite3 >/dev/null || { log "ERROR: sqlite3 missing"; exit 1; }
command -v git >/dev/null || { log "ERROR: git missing"; exit 1; }

# ── 1. DB 増分判定 ────────────────────────────────────
CURRENT_MAX=$(sqlite3 "$DB_FILE" "SELECT COALESCE(MAX(id), 0) FROM posts;")
LAST_CURSOR=$(cat "$CURSOR_FILE" 2>/dev/null || echo 0)
if [ "$CURRENT_MAX" -le "$LAST_CURSOR" ]; then
  log "no delta (max=$CURRENT_MAX cursor=$LAST_CURSOR), skip"
  exit 0
fi
DELTA=$((CURRENT_MAX - LAST_CURSOR))

# ── 2. 障害ガード ─────────────────────────────────────
RECENT_STATUSES=$(sqlite3 "$DB_FILE" "SELECT status FROM checks ORDER BY id DESC LIMIT 3;" | sort -u)
if echo "$RECENT_STATUSES" | grep -qi 'error'; then
  log "recent failures detected ($RECENT_STATUSES), skip"
  exit 0
fi

# ── 3. 頻度上限ガード ─────────────────────────────────
cd "$WORKSPACE_DIR"
LAST_COMMIT_TS=$(git log -1 --format=%ct -- "projects/threads-watcher/threads-watcher-status/state.json" 2>/dev/null || echo 0)
NOW_TS=$(date +%s)
GAP=$((NOW_TS - LAST_COMMIT_TS))
if [ "$LAST_COMMIT_TS" -gt 0 ] && [ "$GAP" -lt "$COMMIT_MIN_GAP_SEC" ]; then
  log "commit gap ${GAP}s < ${COMMIT_MIN_GAP_SEC}s, skip"
  exit 0
fi

# ── 4. snapshot sanity check(BLOB / local_path 漏洩がないこと)─────────
python3 - "$SNAPSHOT_FILE" <<'PY' || { log "ERROR: snapshot sanity check failed"; exit 1; }
import json, sys
with open(sys.argv[1]) as f:
    d = json.load(f)
for p in d.get('posts', []):
    assert 'screenshot_png' not in p, 'BLOB leaked'
    assert 'local_path' not in p, 'local path leaked'
PY

# ── 5. git add + commit(push なし)──────────────────
COMMIT_MSG="chore(threads-watcher): snapshot @ $(date -u +%FT%TZ) (delta=${DELTA})"

if [ "$DRY_RUN" = "1" ]; then
  log "DRY_RUN=1: passed all gates (delta=${DELTA}, recent statuses ok, gap=${GAP}s)"
  log "DRY_RUN=1: would run: git add … && git commit -m \"$COMMIT_MSG\""
  log "DRY_RUN=1: would update cursor: $LAST_CURSOR -> $CURRENT_MAX (skipped)"
  [ "$ENABLE_PUSH" = "1" ] && log "DRY_RUN=1: would also push to $GIT_BRANCH (skipped)"
  exit 0
fi

git add "projects/threads-watcher/threads-watcher-status/state.json"
if git diff --cached --quiet; then
  log "snapshot in git matches DB-derived snapshot, no commit needed"
  echo "$CURRENT_MAX" > "$CURSOR_FILE"
  exit 0
fi

git commit -m "$COMMIT_MSG"
log "committed: $COMMIT_MSG"
echo "$CURRENT_MAX" > "$CURSOR_FILE"

# ── 6. push(オプトイン)──────────────────────────────
if [ "$ENABLE_PUSH" = "1" ]; then
  git push origin "$GIT_BRANCH"
  log "pushed to origin $GIT_BRANCH"
else
  log "ENABLE_PUSH not set, skipping push (commit local only)"
fi

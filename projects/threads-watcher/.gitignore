venv/
.venv/
__pycache__/
*.pyc
/state.json
threads_watcher.db*
screenshots/*
!screenshots/.gitkeep

logs/

# Runtime cursor for sync.py — local-only state, not source.
.sync_cursor

# Cooldown marker for auto-restart-if-stale.sh — local-only state.
.last-auto-restart

# Mutex for restart-watcher.sh concurrent invocations — local-only.
.restart-watcher.lock.d/

# Mutex for sync.py concurrent invocations — local-only.
.sync.lock.d/

# One-off QA artifact dumps (screenshots, reports, zips).
artifacts/
